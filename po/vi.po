msgstr "Chọn đầu vào"

#: crates/sumi-gui/qml/SystemPage.qml:126
msgid "The video input the monitor shows."
msgstr "Đầu vào video mà màn hình hiển thị."

#: crates/sumi-gui/qml/SystemPage.qml:127

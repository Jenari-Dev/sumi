msgstr "Detectare bară de activități"

#: crates/sumi-gui/qml/OledCarePage.qml:60
msgid "Recognises a fixed taskbar at the screen edge and dims it."
msgstr ""
"Recunoaște o bară de activități fixă la marginea ecranului și o atenuează."

#: crates/sumi-gui/qml/OledCarePage.qml:66
msgid "Boundary Detection"
msgstr "Detectare margini"

#: crates/sumi-gui/qml/OledCarePage.qml:67
msgid "Finds the borders of static windows and softens the light along them."
msgstr ""
"Găsește marginile ferestrelor statice și estompează lumina de-a lungul lor."

#: crates/sumi-gui/qml/OledCarePage.qml:73
msgid "Outer Dimming Control"
msgstr "Control atenuare exterioară"

#: crates/sumi-gui/qml/OledCarePage.qml:74
msgid "Lowers brightness toward the outer area of the panel."
msgstr "Reduce luminozitatea spre zona exterioară a panoului."

#: crates/sumi-gui/qml/OledCarePage.qml:80
msgid "Global Dimming Control"
msgstr "Control atenuare globală"

#: crates/sumi-gui/qml/OledCarePage.qml:81
msgid ""
"Lets the monitor adjust brightness across the whole panel for the content."
msgstr ""
"Permite monitorului să ajusteze luminozitatea pe întregul panou în funcție "
"de conținut."

#: crates/sumi-gui/qml/OledCarePage.qml:87
msgid "Uniform Brightness"
msgstr "Luminozitate uniformă"

#: crates/sumi-gui/qml/OledCarePage.qml:88
msgid "Keeps the brightness level steady from scene to scene."
msgstr "Menține nivelul de luminozitate constant de la o scenă la alta."

#: crates/sumi-gui/qml/OledCarePage.qml:93
msgid "Target Mode"
msgstr "Mod țintă"

